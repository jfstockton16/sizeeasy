# Replicate API (for AI image generation)
REPLICATE_API_TOKEN=your_replicate_token_here

# OpenAI API (for fetching object dimensions)
OPENAI_API_KEY=your_openai_api_key_here

# Meshy API (for 3D model generation)
MESHY_API_KEY=your_meshy_api_key_here

# Supabase (Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe (Payment Processing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_monthly_id
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=price_yearly_id

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# App URL
NEXT_PUBLIC_APP_URL=https://sizeeasy.com

# ============================================
# COST PROTECTION & RATE LIMITING
# ============================================

# Redis (Required for cost protection in production)
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=your_redis_token
# Or use Upstash Redis (recommended for serverless)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Cost Limits (in USD)
MAX_DAILY_SPEND=10.00
MAX_HOURLY_SPEND=2.00
MAX_MONTHLY_SPEND=200.00
MAX_USER_DAILY_COST=0.50
MAX_USER_HOURLY_COST=0.10
MAX_SINGLE_REQUEST_COST=0.10
EMERGENCY_SHUTDOWN_LIMIT=50.00

# API Cost Constants (in USD)
OPENAI_COST_PER_CALL=0.015
REPLICATE_COST_PER_CALL=0.04
MESHY_PREVIEW_COST=0.10
MESHY_REFINE_COST=0.30

# Rate Limiting - Free Users
FREE_REQUESTS_PER_MINUTE=2
FREE_REQUESTS_PER_HOUR=10
FREE_REQUESTS_PER_DAY=20

# Rate Limiting - Premium Users
PREMIUM_REQUESTS_PER_MINUTE=10
PREMIUM_REQUESTS_PER_HOUR=100
PREMIUM_REQUESTS_PER_DAY=500

# Global Rate Limits
MAX_CONCURRENT_API_CALLS=5
GLOBAL_REQUESTS_PER_SECOND=2
MAX_QUEUE_LENGTH=100

# Cache Configuration
CACHE_SIMILAR_THRESHOLD=0.85
CACHE_TTL_SECONDS=86400

# Admin Alerts (Optional)
ADMIN_ALERT_EMAIL=admin@yourcompany.com
ADMIN_ALERT_PHONE=+1234567890
COST_ALERT_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Alert Toggles
ENABLE_EMAIL_ALERTS=false
ENABLE_SMS_ALERTS=false
ENABLE_WEBHOOK_ALERTS=false

# Feature Flags
ENABLE_COST_PROTECTION=true
ENABLE_EMERGENCY_SHUTDOWN=true
ENABLE_CIRCUIT_BREAKER=true
ENABLE_ABUSE_DETECTION=true
ENABLE_QUEUE_SYSTEM=true
ENABLE_GRACEFUL_DEGRADATION=true
CACHE_ONLY_MODE=false
MAINTENANCE_MODE=false
